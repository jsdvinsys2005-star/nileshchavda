<!DOCTYPE html>
<html>
<head>
    <title>My Web Page</title>

    <style>
        body {
            font-family: Arial;
            margin: 0;
            background: #f2f2f2;
        }

        header {
            background: blue;
            color: white;
            padding: 20px;
            text-align: center;
        }

        nav {
            background: black;
            padding: 10px;
            text-align: center;
        }

        nav a {
            color: white;
            margin: 15px;
            text-decoration: none;
        }

        .box {
            background: white;
            width: 80%;
            margin: 30px auto;
            padding: 20px;
            border-radius: 10px;
            text-align: center;
        }

        button {
            background: green;
            color: white;
            padding: 10px 20px;
            border: none;
            cursor: pointer;
        }

        footer {
            background: black;
            color: white;
            text-align: center;
            padding: 10px;
        }
    </style>
</head>

<body>

<header>
    <h1>nilesh</h1>
    <p>Simple Web Page Design</p>
</header>

<nav>
    <a href="#">Home</a>
    <a href="#">About</a>
    <a href="#">Contact</a>
</nav>

<div class="box">
    <h2>My First Web Page</h2>
    <p>
        This is a simple website created using HTML and CSS.
    </p>

    <button>Click Here</button>
</div>

<footer>
    <p>© 2026 My Website</p>
</footer>

</body>
</html>
