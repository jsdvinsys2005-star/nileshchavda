<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ShopZone</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#eaeded;
}

/* Header */
header{
    background:#131921;
    color:white;
    padding:15px;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.logo{
    font-size:28px;
    font-weight:bold;
    color:#ff9900;
}

.search{
    width:50%;
    display:flex;
}

.search input{
    width:100%;
    padding:10px;
    border:none;
}

.search button{
    padding:10px 15px;
    background:#febd69;
    border:none;
    cursor:pointer;
}

nav a{
    color:white;
    text-decoration:none;
    margin-left:15px;
}

/* Banner */
.banner{
    background:#4a90e2;
    color:white;
    text-align:center;
    padding:60px 20px;
}

.banner h1{
    font-size:40px;
}

.banner p{
    margin-top:10px;
}

/* Products */
.products{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
    padding:30px;
}

.card{
    background:white;
    padding:15px;
    border-radius:8px;
    text-align:center;
    box-shadow:0 2px 6px rgba(0,0,0,.2);
}

.card img{
    width:100%;
    height:180px;
    object-fit:cover;
    border-radius:5px;
}

.card h3{
    margin:10px 0;
}

.price{
    color:green;
    font-size:20px;
    font-weight:bold;
}

.card button{
    margin-top:10px;
    width:100%;
    padding:10px;
    background:#ff9900;
    border:none;
    cursor:pointer;
}

.card button:hover{
    background:#e68a00;
}

/* Footer */
footer{
    background:#131921;
    color:white;
    text-align:center;
    padding:15px;
}
</style>
</head>

<body>

<header>
    <div class="logo">ShopZone</div>

    <div class="search">
        <input type="text" placeholder="Search products...">
        <button>Search</button>
    </div>

    <nav>
        <a href="#">Home</a>
        <a href="#">Orders</a>
        <a href="#">Cart 🛒</a>
    </nav>
</header>

<section class="banner">
    <h1>Welcome to ShopZone</h1>
    <p>Great Deals Every Day!</p>
</section>

<section class="products">

<div class="card">
    <img src="https://picsum.photos/250/180?1">
    <h3>Smartphone</h3>
    <p class="price">$299</p>
    <button>Add to Cart</button>
</div>

<div class="card">
    <img src="https://picsum.photos/250/180?2">
    <h3>Laptop</h3>
    <p class="price">$799</p>
    <button>Add to Cart</button>
</div>

<div class="card">
    <img src="https://picsum.photos/250/180?3">
    <h3>Headphones</h3>
    <p class="price">$49</p>
    <button>Add to Cart</button>
</div>

<div class="card">
    <img src="https://picsum.photos/250/180?4">
    <h3>Smart Watch</h3>
    <p class="price">$99</p>
    <button>Add to Cart</button>
</div>

</section>

<footer>
    <p>© 2026 ShopZone. All Rights Reserved.</p>
</footer>

</body>
</html>
